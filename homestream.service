# setup.sh installs a copy of this file with ExecStart pointing at the folder
# the program really lives in.
[Unit]
Description=HomeStream media server

[Service]
ExecStart=%h/Projects/HomeStream/homestream
EnvironmentFile=%h/.config/homestream/env
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes

[Install]
WantedBy=default.target
